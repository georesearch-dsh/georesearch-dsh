{
  "name": "georesearch-dsh-workspace",
  "version": "0.1.0",
  "description": "Release workspace for the GeoResearch plugin for DeepSeek Harness",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LYP-PYL/georesearch-dsh.git"
  },
  "homepage": "https://github.com/LYP-PYL/georesearch-dsh#readme",
  "bugs": {
    "url": "https://github.com/LYP-PYL/georesearch-dsh/issues"
  },
  "license": "MIT",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "clean": "pnpm -r exec tsc -b --clean",
    "build": "pnpm run build:contracts && pnpm run build:runtime && pnpm run build:installer",
    "build:contracts": "pnpm --filter @georesearch/dsh-contracts run build",
    "build:runtime": "pnpm --filter @georesearch/dsh-provider-lifecycle run build && pnpm --filter @georesearch/dsh-repository-providers run build && pnpm --filter @georesearch/dsh-compat-rc5 run build && pnpm --filter @georesearch/dsh-installation-guard run build && pnpm --filter @georesearch/dsh-runtime-lease run build && pnpm --filter @georesearch/dsh-policy run build && pnpm --filter @georesearch/dsh-project-provider-files run build && pnpm --filter @georesearch/dsh-project-service run build && pnpm --filter @georesearch/dsh-file-service run build && pnpm --filter @georesearch/dsh-evidence-providers run build && pnpm --filter @georesearch/dsh-evidence-service run build && pnpm --filter @georesearch/dsh-run-supervisor run build && pnpm --filter @georesearch/dsh-run-service run build && pnpm --filter @georesearch/dsh-reproduction-service run build && pnpm --filter @georesearch/dsh-geospatial-provider-python run build && pnpm --filter @georesearch/dsh-geospatial-service run build && pnpm --filter @georesearch/dsh-experiment-service run build && pnpm --filter @georesearch/dsh-validation-service run build && pnpm --filter @georesearch/dsh-claim-service run build && pnpm --filter @georesearch/dsh-writing-service run build && pnpm --filter @georesearch/dsh-delegation-tools run build && pnpm --filter @georesearch/dsh-prompt run build && pnpm --filter @georesearch/dsh-agent-lifecycle run build && pnpm --filter @georesearch/dsh-bundle run build",
    "build:installer": "pnpm --filter @georesearch/dsh-installer run build",
    "typecheck": "pnpm run build",
    "test": "pnpm run distribution && vitest run",
    "test:watch": "vitest",
    "baseline": "node --experimental-strip-types scripts/capture-baseline.ts",
    "cache:analyze": "node --experimental-strip-types scripts/analyze-prompt-cache.ts",
    "cache:compare": "node --experimental-strip-types scripts/compare-prompt-cache-headers.ts",
    "dsh-std:sync": "node --experimental-strip-types scripts/sync-dsh-standard-manifest.ts",
    "dsh-std:check": "pnpm --filter @georesearch/dsh-bundle run build && node --experimental-strip-types scripts/sync-dsh-standard-manifest.ts --check && node --experimental-strip-types scripts/verify-dsh-standard.ts && vitest run tests/dsh-standard-conformance.spec.ts",
    "distribution": "pnpm run build && node --experimental-strip-types scripts/build-distribution.ts",
    "pack": "pnpm run distribution && node --experimental-strip-types scripts/pack-workspace.ts && node --experimental-strip-types scripts/verify-packed-tarballs.ts",
    "probe:worker": "node --experimental-strip-types scripts/probe-python-worker.ts",
    "probe:dpapi": "node --experimental-strip-types scripts/probe-dpapi.ts",
    "probe:phase3-live": "node --experimental-strip-types scripts/probe-phase3-live.ts",
    "probe:phase4-live": "node --experimental-strip-types scripts/probe-phase4-live.ts",
    "probe:phase5-live": "node --experimental-strip-types scripts/probe-phase5-live.ts",
    "probe:phase7-live": "node --experimental-strip-types scripts/probe-phase7-live.ts",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "release:preflight": "node --experimental-strip-types scripts/verify-release-environment.ts && pnpm run probe:dpapi",
    "release:check": "node --experimental-strip-types scripts/verify-release-readiness.ts",
    "release:publish-assets": "node --experimental-strip-types scripts/publish-release-assets.ts",
    "release:gate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-release-gate.ps1",
    "phase1:gate": "pnpm test && pnpm run pack && pnpm run probe:worker && pnpm run probe:dpapi",
    "phase2:boundary": "node --experimental-strip-types scripts/verify-phase2-boundary.ts",
    "phase2:gate": "pnpm run phase1:gate && pnpm run phase2:boundary",
    "phase2.5:boundary": "node --experimental-strip-types scripts/verify-phase25-boundary.ts",
    "phase2.5:gate": "pnpm run phase2:gate && pnpm run phase2.5:boundary",
    "phase3:boundary": "node --experimental-strip-types scripts/verify-phase3-boundary.ts",
    "phase3:gate": "pnpm run phase2.5:gate && pnpm run phase3:boundary",
    "phase4:boundary": "node --experimental-strip-types scripts/verify-phase4-boundary.ts",
    "phase4:gate": "pnpm run phase3:gate && pnpm run phase4:boundary",
    "phase5:boundary": "node --experimental-strip-types scripts/verify-phase5-boundary.ts",
    "phase5:gate": "pnpm run phase4:gate && pnpm run phase5:boundary",
    "phase6:boundary": "node --experimental-strip-types scripts/verify-phase6-boundary.ts",
    "phase6:gate": "pnpm run phase5:gate && pnpm run phase6:boundary",
    "test:tarball-clean-home": "vitest run packages/installer/tests/tarball-clean-home.spec.ts",
    "test:windows-release": "vitest run packages/installer/tests/preflight.spec.ts packages/project-provider-files/tests/win32-native.spec.ts packages/installation-guard/tests/nonce-protection.spec.ts && pnpm run probe:dpapi",
    "test:scientific-golden": "vitest run tests/scientific-golden.spec.ts && python -m unittest discover -s python/tests -p test_scientific_golden.py",
    "phase7:release-tests": "pnpm run test:tarball-clean-home && pnpm run test:windows-release && pnpm run test:scientific-golden",
    "phase7:boundary": "node --experimental-strip-types scripts/verify-phase7-boundary.ts",
    "phase7:gate": "pnpm run release:preflight && pnpm run phase6:gate && pnpm run phase7:release-tests && pnpm run phase7:boundary",
    "schemas:phase3": "pnpm run build:contracts && node --experimental-strip-types scripts/sync-phase3-schemas.ts",
    "schemas:phase4": "pnpm run build:contracts && node --experimental-strip-types scripts/sync-phase4-schemas.ts",
    "schemas:phase5": "pnpm run build:contracts && node --experimental-strip-types scripts/sync-phase5-schemas.ts",
    "schemas:phase6": "pnpm run build:contracts && node --experimental-strip-types scripts/sync-phase6-schemas.ts"
  },
  "devDependencies": {
    "@dsh-std/adapter-dsh": "0.1.1-rc.1",
    "@dsh-std/manifest": "0.1.1-rc.1",
    "@dsh-std/sdk": "0.1.1-rc.1",
    "@dsh-std/tool": "0.1.1-rc.1",
    "@deepseek-ai/cordis": "link:../.dsh/profiles/node_modules/@deepseek-ai/cordis",
    "@deepseek-ai/dsh-agent": "link:../.dsh/profiles/node_modules/@deepseek-ai/dsh-agent",
    "@deepseek-ai/dsh-agent-presets": "link:../.dsh/profiles/node_modules/@deepseek-ai/dsh-agent-presets",
    "@deepseek-ai/dsh-attachment": "link:../.dsh/profiles/node_modules/@deepseek-ai/dsh-attachment",
    "@deepseek-ai/dsh-commands": "link:../.dsh/profiles/node_modules/@deepseek-ai/dsh-commands",
    "@deepseek-ai/dsh-client-runtime": "link:../.dsh/profiles/node_modules/@deepseek-ai/dsh-client-runtime",
    "@deepseek-ai/dsh-client-ui-attachment": "link:../.dsh/profiles/node_modules/@deepseek-ai/dsh-client-ui-attachment",
    "@deepseek-ai/dsh-client-ui-conversation": "link:../.dsh/profiles/node_modules/@deepseek-ai/dsh-client-ui-conversation",
    "@deepseek-ai/dsh-client-ui-input-trigger": "link:../.dsh/profiles/node_modules/@deepseek-ai/dsh-client-ui-input-trigger",
    "@deepseek-ai/dsh-client-ui-primitives": "link:../.dsh/profiles/node_modules/@deepseek-ai/dsh-client-ui-primitives",
    "@deepseek-ai/dsh-client-ui-slots": "link:../.dsh/profiles/node_modules/@deepseek-ai/dsh-client-ui-slots",
    "@deepseek-ai/dsh-credentials": "link:../.dsh/profiles/node_modules/@deepseek-ai/dsh-credentials",
    "@deepseek-ai/dsh-home-paths": "link:../.dsh/profiles/node_modules/@deepseek-ai/dsh-home-paths",
    "@deepseek-ai/dsh-host-webserver": "link:../.dsh/profiles/node_modules/@deepseek-ai/dsh-host-webserver",
    "@deepseek-ai/dsh-llm": "link:../.dsh/profiles/node_modules/@deepseek-ai/dsh-llm",
    "@deepseek-ai/dsh-sandbox": "link:../.dsh/profiles/node_modules/@deepseek-ai/dsh-sandbox",
    "@deepseek-ai/dsh-sandbox-policy": "link:../.dsh/profiles/node_modules/@deepseek-ai/dsh-sandbox-policy",
    "@deepseek-ai/dsh-scope": "link:../.dsh/profiles/node_modules/@deepseek-ai/dsh-scope",
    "@deepseek-ai/dsh-session": "link:../.dsh/profiles/node_modules/@deepseek-ai/dsh-session",
    "@deepseek-ai/dsh-subagent": "link:../.dsh/profiles/node_modules/@deepseek-ai/dsh-subagent",
    "@deepseek-ai/dsh-subprocess": "link:../.dsh/profiles/node_modules/@deepseek-ai/dsh-subprocess",
    "@deepseek-ai/dsh-system-prompt": "link:../.dsh/profiles/node_modules/@deepseek-ai/dsh-system-prompt",
    "@deepseek-ai/dsh-tools": "link:../.dsh/profiles/node_modules/@deepseek-ai/dsh-tools",
    "@deepseek-ai/dsh-typert-protocol": "link:../.dsh/profiles/node_modules/@deepseek-ai/dsh-typert-protocol",
    "@deepseek-ai/dsh-user-approval": "link:../.dsh/profiles/node_modules/@deepseek-ai/dsh-user-approval",
    "@deepseek-ai/schemastery": "link:../.dsh/profiles/node_modules/@deepseek-ai/schemastery",
    "@georesearch/dsh-agent-lifecycle": "workspace:*",
    "@georesearch/dsh-bundle": "workspace:*",
    "@georesearch/dsh-claim-service": "workspace:*",
    "@georesearch/dsh-compat-rc5": "workspace:*",
    "@georesearch/dsh-contracts": "workspace:*",
    "@georesearch/dsh-delegation-tools": "workspace:*",
    "@georesearch/dsh-evidence-providers": "workspace:*",
    "@georesearch/dsh-evidence-service": "workspace:*",
    "@georesearch/dsh-experiment-service": "workspace:*",
    "@georesearch/dsh-file-service": "workspace:*",
    "@georesearch/dsh-geospatial-provider-python": "workspace:*",
    "@georesearch/dsh-geospatial-service": "workspace:*",
    "@georesearch/dsh-installation-guard": "workspace:*",
    "@georesearch/dsh-installer": "workspace:*",
    "@georesearch/dsh-policy": "workspace:*",
    "@georesearch/dsh-project-provider-files": "workspace:*",
    "@georesearch/dsh-project-service": "workspace:*",
    "@georesearch/dsh-prompt": "workspace:*",
    "@georesearch/dsh-provider-lifecycle": "workspace:*",
    "@georesearch/dsh-repository-providers": "workspace:*",
    "@georesearch/dsh-reproduction-service": "workspace:*",
    "@georesearch/dsh-run-service": "workspace:*",
    "@georesearch/dsh-run-supervisor": "workspace:*",
    "@georesearch/dsh-runtime-lease": "workspace:*",
    "@georesearch/dsh-validation-service": "workspace:*",
    "@georesearch/dsh-writing-service": "workspace:*",
    "@napi-rs/canvas": "1.0.6",
    "@types/bmp-js": "0.1.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/tar-stream": "^3.1.4",
    "@types/yauzl": "^2.10.3",
    "hyparquet-writer": "0.16.6",
    "js-yaml": "^4.1.0",
    "koffi": "3.1.1",
    "lucide-react": "^0.468.0",
    "publint": "0.3.24",
    "react": "link:../.dsh/profiles/node_modules/react",
    "tar-stream": "^3.1.7",
    "tsdown": "^0.22.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
