{
  "name": "@georesearch/dsh-compat-rc5",
  "version": "0.1.0",
  "description": "The only GeoResearch adapter allowed to touch DeepSeek Harness rc.5 APIs directly",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    }
  },
  "files": ["lib", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@georesearch/dsh-contracts": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.5",
    "@deepseek-ai/dsh-agent-presets": "0.1.0-rc.5",
    "@deepseek-ai/dsh-attachment": "0.1.0-rc.5",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-attachment": "0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-input-trigger": "0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.0-rc.5",
    "@deepseek-ai/dsh-credentials": "0.1.0-rc.5",
    "@deepseek-ai/dsh-home-paths": "0.1.0-rc.5",
    "@deepseek-ai/dsh-host-webserver": "0.1.0-rc.5",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.5",
    "@deepseek-ai/dsh-sandbox": "0.1.0-rc.5",
    "@deepseek-ai/dsh-sandbox-policy": "0.1.0-rc.5",
    "@deepseek-ai/dsh-session": "0.1.0-rc.5",
    "@deepseek-ai/dsh-subagent": "0.1.0-rc.5",
    "@deepseek-ai/dsh-subprocess": "0.1.0-rc.5",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.5",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.5",
    "@deepseek-ai/dsh-user-approval": "0.1.0-rc.5"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/georesearch-dsh/georesearch-dsh.git"
  },
  "homepage": "https://github.com/georesearch-dsh/georesearch-dsh#readme",
  "bugs": {
    "url": "https://github.com/georesearch-dsh/georesearch-dsh/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT"
}
