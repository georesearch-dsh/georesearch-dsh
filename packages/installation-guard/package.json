{
  "name": "@georesearch/dsh-installation-guard",
  "version": "0.1.0",
  "description": "Fail-closed activation validation for the managed GeoResearch installation",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./validation": {
      "types": "./lib/validation.d.ts",
      "default": "./lib/validation.js"
    },
    "./nonce-protection": {
      "types": "./lib/nonce-protection.d.ts",
      "default": "./lib/nonce-protection.js"
    },
    "./operator-scope": {
      "types": "./lib/operator-scope.d.ts",
      "default": "./lib/operator-scope.js"
    }
  },
  "files": ["lib", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@georesearch/dsh-compat-rc5": "workspace:*",
    "@georesearch/dsh-contracts": "workspace:*",
    "koffi": "3.1.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT"
}
