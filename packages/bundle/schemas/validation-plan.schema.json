{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://georesearch.local/schemas/validation-plan.schema.json",
  "title": "GeoResearch Validation Plan",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "planId": {
      "type": "string",
      "minLength": 1
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "workspaceId": {
      "type": "string",
      "minLength": 1
    },
    "workspaceBindingVersion": {
      "type": "integer",
      "minimum": 1
    },
    "domain": {
      "type": "string",
      "enum": [
        "geodata",
        "experiment",
        "citation",
        "manuscript"
      ]
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "geodata-report",
              "dataset-manifest",
              "experiment-spec",
              "run",
              "result",
              "evidence",
              "reproduction-report",
              "claim",
              "research-brief",
              "manuscript"
            ]
          },
          "subjectId": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "required": [
          "kind",
          "subjectId",
          "digest"
        ]
      }
    },
    "validators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "validatorId": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "mandatory": {
            "type": "boolean"
          },
          "configDigest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "required": [
          "validatorId",
          "version",
          "mandatory",
          "configDigest"
        ]
      }
    },
    "policyDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "createdAt": {
      "type": "string",
      "minLength": 1
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "planId",
    "projectId",
    "workspaceId",
    "workspaceBindingVersion",
    "domain",
    "subjects",
    "validators",
    "policyDigest",
    "createdAt",
    "digest"
  ]
}
