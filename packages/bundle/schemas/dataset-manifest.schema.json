{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://georesearch.local/schemas/dataset-manifest.schema.json",
  "title": "GeoResearch Dataset Manifest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "datasetId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "workspaceId": {
      "type": "string",
      "minLength": 1
    },
    "workspaceBindingVersion": {
      "type": "integer",
      "minimum": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "uri": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "accessedAt": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "uri",
        "provider",
        "accessedAt"
      ]
    },
    "assetRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "artifactId": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "kind": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "artifactId",
          "digest",
          "kind"
        ]
      }
    },
    "assetDigests": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "spatialExtent": {
      "type": [
        "array",
        "null"
      ],
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number"
      }
    },
    "timeRange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "end": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "start",
        "end"
      ]
    },
    "crs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authority": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "wktDigest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "axisOrder": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "units": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "authority",
        "wktDigest",
        "axisOrder",
        "units"
      ]
    },
    "resolution": {
      "type": [
        "array",
        "null"
      ],
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number"
      }
    },
    "bands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "dataType": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "scale": {
            "type": "number"
          },
          "offset": {
            "type": "number"
          },
          "noData": {
            "type": [
              "number",
              "null"
            ]
          },
          "colorInterpretation": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          }
        },
        "required": [
          "index",
          "name",
          "dataType",
          "unit",
          "scale",
          "offset",
          "noData",
          "colorInterpretation"
        ]
      }
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "dataType": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "nullable": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "dataType",
          "unit",
          "nullable"
        ]
      }
    },
    "qualityMasks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "preprocessingLevel": {
      "type": "string",
      "minLength": 1
    },
    "labelSchema": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "value": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "value",
          "label"
        ]
      }
    },
    "splits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "splitId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "role": {
            "type": "string",
            "enum": [
              "train",
              "validation",
              "test",
              "holdout"
            ]
          },
          "sampleIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "spatialUnitIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "sourceAssetDigests": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "temporalKeys": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "splitId",
          "role",
          "sampleIds",
          "spatialUnitIds",
          "sourceAssetDigests",
          "temporalKeys"
        ]
      }
    },
    "knownLimitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "inspectionReportDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "verified",
        "blocked"
      ]
    },
    "createdAt": {
      "type": "string",
      "minLength": 1
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "datasetId",
    "name",
    "version",
    "projectId",
    "workspaceId",
    "workspaceBindingVersion",
    "source",
    "assetRefs",
    "assetDigests",
    "spatialExtent",
    "timeRange",
    "crs",
    "resolution",
    "bands",
    "fields",
    "qualityMasks",
    "preprocessingLevel",
    "labelSchema",
    "splits",
    "knownLimitations",
    "inspectionReportDigest",
    "status",
    "createdAt",
    "digest"
  ]
}
