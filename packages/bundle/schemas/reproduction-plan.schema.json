{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://georesearch.local/schemas/reproduction-plan.schema.json",
  "title": "GeoResearch Reproduction Plan",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "planId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "sourceId": {
      "type": "string",
      "minLength": 1
    },
    "repositoryAuditId": {
      "type": "string",
      "minLength": 1
    },
    "targetRepository": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "remoteUrl": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "remoteUrl",
        "commit"
      ]
    },
    "targetData": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "targetResults": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "resultId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "metric": {
            "type": "string",
            "minLength": 1
          },
          "expectedValue": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "unit": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "evidenceId": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          }
        },
        "required": [
          "resultId",
          "description",
          "metric",
          "expectedValue",
          "unit",
          "evidenceId"
        ]
      }
    },
    "scope": {
      "type": "string",
      "enum": [
        "exact",
        "metric-equivalent",
        "functional",
        "conceptual",
        "partial"
      ]
    },
    "environmentRequirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "missingMaterials": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "stepId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "inspect",
              "modify",
              "test",
              "formal-run",
              "compare"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "expectedOutputs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "stepId",
          "kind",
          "description",
          "expectedOutputs"
        ]
      }
    },
    "expectedOutputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tolerances": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "resultId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "absolute": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "relative": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          }
        },
        "required": [
          "resultId",
          "absolute",
          "relative"
        ]
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "retryable": {
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "retryable"
        ]
      }
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "workspaceId": {
      "type": "string",
      "minLength": 1
    },
    "workspaceBindingVersion": {
      "type": "integer",
      "minimum": 1
    },
    "repositoryAuditDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sourceTreeDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "status": {
      "const": "candidate"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "planId",
    "sourceId",
    "repositoryAuditId",
    "targetRepository",
    "targetData",
    "targetResults",
    "scope",
    "environmentRequirements",
    "missingMaterials",
    "steps",
    "expectedOutputs",
    "tolerances",
    "blockers",
    "projectId",
    "workspaceId",
    "workspaceBindingVersion",
    "repositoryAuditDigest",
    "sourceTreeDigest",
    "status",
    "createdAt",
    "digest"
  ]
}
