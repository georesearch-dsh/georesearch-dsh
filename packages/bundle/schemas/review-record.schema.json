{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://georesearch.local/schemas/review-record.schema.json",
  "title": "GeoResearch Review Record",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "review"
    },
    "reviewId": {
      "type": "string",
      "minLength": 1
    },
    "subjectRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "geodata-report",
              "dataset-manifest",
              "experiment-spec",
              "run",
              "result",
              "evidence",
              "reproduction-report",
              "claim",
              "research-brief",
              "manuscript"
            ]
          },
          "subjectId": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "required": [
          "kind",
          "subjectId",
          "digest"
        ]
      }
    },
    "validationReportIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "findingId": {
            "type": "string",
            "minLength": 1
          },
          "validatorId": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "error",
              "hard"
            ]
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "subjectIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "findingId",
          "validatorId",
          "severity",
          "code",
          "message",
          "subjectIds"
        ]
      }
    },
    "recommendation": {
      "type": "string",
      "enum": [
        "accept",
        "revise",
        "reject"
      ]
    },
    "supersedesReviewIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "workspaceId": {
      "type": "string",
      "minLength": 1
    },
    "workspaceBindingVersion": {
      "type": "integer",
      "minimum": 1
    },
    "createdAt": {
      "type": "string",
      "minLength": 1
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "reviewId",
    "subjectRefs",
    "validationReportIds",
    "findings",
    "recommendation",
    "supersedesReviewIds",
    "projectId",
    "workspaceId",
    "workspaceBindingVersion",
    "createdAt",
    "digest"
  ]
}
