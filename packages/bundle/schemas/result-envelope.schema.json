{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://georesearch.local/schemas/result-envelope.schema.json",
  "title": "GeoResearch Result Envelope",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "resultId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "metricId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "aggregation": {
            "type": "string",
            "minLength": 1
          },
          "uncertainty": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "none",
                  "standard-deviation",
                  "standard-error",
                  "confidence-interval"
                ]
              },
              "level": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "lower": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "upper": {
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "required": [
              "kind",
              "level",
              "lower",
              "upper"
            ]
          },
          "comparisonTarget": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "datasetId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              },
              "region": {
                "type": "string",
                "minLength": 1
              },
              "sensor": {
                "type": "string",
                "minLength": 1
              },
              "split": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "datasetId",
              "region",
              "sensor",
              "split"
            ]
          },
          "artifactIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "resultId",
          "metricId",
          "value",
          "unit",
          "aggregation",
          "uncertainty",
          "comparisonTarget",
          "scope",
          "artifactIds"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "results"
  ]
}
